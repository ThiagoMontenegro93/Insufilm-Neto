# Copie para .env.local e preencha. Nunca faça commit de .env.local.

# Banco (PostgreSQL). Sem ele o app roda em modo demonstração (config no navegador).
DATABASE_URL="postgresql://USUARIO:DB_PASSWORD@HOST:5432/filmprotect?schema=public"

# Auth. Sem NEXTAUTH_SECRET o /admin fica aberto em modo demonstração.
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="SECRET_KEY_AQUI"   # gere com: openssl rand -base64 32

# Prospecção (APIs oficiais)
GOOGLE_PLACES_API_KEY="API_KEY_AQUI"
WHATSAPP_CLOUD_TOKEN="TOKEN_AQUI"
WHATSAPP_PHONE_NUMBER_ID="ID_AQUI"
SMTP_URL="smtp://USUARIO:SENHA@HOST:587"

# Mapas e arquivos
MAPBOX_TOKEN="pk.TOKEN_AQUI"
R2_ACCOUNT_ID="ID_AQUI"
R2_ACCESS_KEY_ID="API_KEY_AQUI"
R2_SECRET_ACCESS_KEY="SECRET_KEY_AQUI"
R2_BUCKET_PUBLICO="filmprotect-galeria"
R2_BUCKET_PRIVADO="filmprotect-kyc"

# Pagamentos
STRIPE_SECRET_KEY="sk_test_SECRET_KEY_AQUI"
STRIPE_PRICE_FILIAL="price_ID_AQUI"   # R$ 97/mês por filial
